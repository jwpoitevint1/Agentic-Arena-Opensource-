APP_NAME=Agentic Arena
APP_VERSION=0.1.0
APP_ENV=development
APP_CONFIG_PATH=config.yaml

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

API_PREFIX=/api/v1
API_DOCS_ENABLED=true

# Runtime perimeter controls.
# Leave API auth disabled until the upstream proxy has the same secret configured.
API_AUTH_REQUIRED=false
ARENA_API_KEY=
ALLOWED_HOSTS=
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
ALLOW_DIRECT_MODEL_ROUTES=false
ENABLE_SYSTEM_DIAGNOSTICS=false

# Comma-separated origins. Keep empty until a UI origin is known.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# OpenRouter model gateway. Keep the real API key out of GitHub.
OPEN_AI_IMPORT=

# CV1.1 Open Policy Agent decision point. Keep OPA bound to localhost in production.
OPA_URL=http://127.0.0.1:8181

# Neon Postgres targets. Keep real credentials out of GitHub.
DB_AGENTIC_GOV_01=
DB_AGENTIC_GOV_02=
DB_AGENTIC_GOV_03=
DB_AGENTIC_GOV_04=
DB_AGENTIC_GOV_05=
DB_AGENTIC_GOV_06=
DB_AGENTIC_UNGOV_01=
DB_AGENTIC_UNGOV_02=
DB_AGENTIC_UNGOV_03=
DB_AGENTIC_UNGOV_04=
DB_AGENTIC_UNGOV_05=
DB_AGENTIC_UNGOV_06=


# Agentic audit integrity. Use a random secret with at least 256 bits of entropy.
# The key signs both governed and ungoverned chains with domain-separated HMAC keys.
# Keep the real key only in deployment secret storage.
AGENTIC_AUDIT_HMAC_KEY=
AGENTIC_AUDIT_HMAC_KEY_ID=v1

# Separate evidence databases used by the agentic run recorder.
DB_LOG_AGENTIC_GOV=
DB_LOG_AGENTIC_UNGOV=
