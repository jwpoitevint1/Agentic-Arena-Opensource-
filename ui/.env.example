# Vercel server-side function configuration.
# BACKEND_URL may be omitted while using the current Railway public API endpoint.
BACKEND_URL=https://agentic-arena-api-production.up.railway.app

# T2 backend used by the governed bot tabs. Keep this separate from the Arena analytics backend when deployed.
T2_BACKEND_URL=https://replace-with-t2-backend.example

# Optional server-side authentication. Never prefix these with VITE_ and never expose them to browser code.
# BACKEND_AUTH_VALUE=replace-with-vercel-secret\n# The proxy always forwards this secret as x-arena-api-key to match the FastAPI perimeter contract.
